# Rust build artifacts
/target/
**/*.rs.bk

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/
.windsurf/

# OS generated files
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Python scripts (cleanup scripts from pruning)
*.py
# ...except the repo's own evidence gates: claim_gate / jev_obs_judge / validate_manifest
!tools/*.py
# Offline regression checks must travel with the tools they verify.
!tests/test_*.py
# Four historical audit entrypoints and their shared pinned-input loader only.
!audit-r12-scratch/verify_core.py
!audit-r12-scratch/verify_part2.py
!audit-r12-scratch/verify_part3.py
!audit-r12-scratch/verify_part4.py
!audit-r12-scratch/audit_inputs.py
# ...and the ACI-Bench dataset itself: fixture code, runners and scorers.
# Without these a fresh clone has the task descriptions but not the code they edit.
!bench/aci/**/*.py
**/__pycache__/
*.py[cod]

# Error logs from pruning
*_errors*.txt
full_errors.txt

# Coverage artifacts
.coverage
*.coverage

# Temp test files
_ae_test.txt
test_agent.txt
agent_test.txt
lock_test.txt
lock_test.txt.ae_lock
test_lock.txt
test_lock.txt.ae_lock

# Agent observation artifacts (content-addressed, TTL-managed)
.ae/results/

# Local audit journal (do not commit)
.ae/audit.log
.ae/trash/

# Editor planning notes
.trae/

# Local agent tool installs (e.g. the task-forest CLI). The forest DATA lives in
# .agent-workbench/ and is committed; see docs/task-forest-policy.md §7.
.mimocode/

# Generated run artifacts (never commit: 35k+ files, per-run outputs)
# Keep only curated top-level results files and the explicitly whitelisted
# tf* result dirs; ignore every other per-run output directory.
bench/aci/results/*/
!bench/aci/results/tf45/
!bench/aci/results/tf62/
!bench/aci/results/tf67/
!bench/aci/results/tf72/
!bench/aci/results/tf83/
!bench/aci/results/tf84/
!bench/aci/results/tf85/

# Local audit scratch (has its own byte-pinned package; not the rest)
audit-r12-scratch/
!audit-r12-scratch/verify_core.py
!audit-r12-scratch/verify_part2.py
!audit-r12-scratch/verify_part3.py
!audit-r12-scratch/verify_part4.py
!audit-r12-scratch/audit_inputs.py
!audit-r12-scratch/r12-inputs.json
!audit-r12-scratch/r12-reference/
!audit-r12-scratch/r12-reference/*.json
!audit-r12-scratch/r12-inputs/
!audit-r12-scratch/r12-inputs/*.json

# Runtime status/lock files and intermediate task candidates
*.status.json
*.status.json.lock.guard
bench/aci/candidates/
