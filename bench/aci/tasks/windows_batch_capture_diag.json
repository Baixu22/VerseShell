{
  "id": "windows_batch_capture_diag",
  "version": "1.0.0",
  "lang": "shell",
  "platform": [
    "windows",
    "any"
  ],
  "prompt": "Extract the first error location from broken_build.log into ERR.txt as path:line.",
  "workspace_fixture": "windows_batch_capture_diag",
  "modes": [
    "raw_shell",
    "verseshell_aci"
  ],
  "timeout_sec": 300,
  "weight": 1.0,
  "success": {
    "type": "all",
    "of": [
      {
        "type": "file_contains",
        "path": "ERR.txt",
        "contains": ":"
      },
      {
        "type": "file_contains",
        "path": "ERR.txt",
        "contains": "12"
      }
    ]
  }
}
